# Local SQLite; no provider credentials required.
CINEMAGO_DB_PATH=data/cinemago.sqlite
# Set to mock to preview the catalogue without database access.
CINEMAGO_DATA_MODE=sqlite
# Optional hosted Postgres (server only; never use NEXT_PUBLIC_ for the secret).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-server-secret
